<!-- The panel's colors in dark mode. PanelTheme.Light.xaml holds the same keys. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PanelBackground" Color="#1E1E20" />
    <SolidColorBrush x:Key="PanelFooter" Color="#19191B" />
    <SolidColorBrush x:Key="Divider" Color="#2E2E33" />
    <SolidColorBrush x:Key="Text" Color="#ECECEE" />
    <SolidColorBrush x:Key="TextDim" Color="#A6A6AD" />
    <SolidColorBrush x:Key="TextFaint" Color="#8C8C94" />
    <SolidColorBrush x:Key="Accent" Color="#8AB8FF" />
    <SolidColorBrush x:Key="OnAccent" Color="#111114" />
    <SolidColorBrush x:Key="SelectionFill" Color="#26324A" />
    <SolidColorBrush x:Key="SelectionStroke" Color="#558AB8FF" />
    <SolidColorBrush x:Key="HoverFill" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlFill" Color="#2A2A2E" />
    <SolidColorBrush x:Key="ControlStroke" Color="#3A3A40" />
    <SolidColorBrush x:Key="KbdStroke" Color="#44444C" />
    <SolidColorBrush x:Key="Danger" Color="#FFB3A8" />
    <SolidColorBrush x:Key="Ok" Color="#5FD39A" />
    <SolidColorBrush x:Key="Warn" Color="#F2CF73" />
</ResourceDictionary>
