<Window x:Class="Files.UI.ScreenTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen text" Width="560" Height="520" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource Text}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Clear all" Margin="8,0,0,0"
                    Style="{StaticResource SettingsButton}" Click="OnClear" />
            <TextBox x:Name="Filter" TextChanged="OnFilter" AutomationProperties.Name="Filter screen text" />
        </DockPanel>
        <TextBlock x:Name="Note" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap"
                   Style="{StaticResource RowDescription}" />
        <ListBox x:Name="Entries" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Screen text read">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                <Button Content="Copy" Style="{StaticResource SettingsButton}" Click="OnCopy" Margin="0,0,6,0" />
                                <Button Content="Search" Style="{StaticResource SettingsButton}" Click="OnSearch" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Heading}" Style="{StaticResource RowDescription}" TextTrimming="CharacterEllipsis" />
                                <ItemsControl ItemsSource="{Binding Lines}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" FontFamily="Consolas" ToolTip="{Binding Hint}">
                                                <Run Text="{Binding Text, Mode=OneWay}" />
                                                <Run Text="{Binding Mark, Mode=OneWay}" Foreground="{DynamicResource Warn}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
