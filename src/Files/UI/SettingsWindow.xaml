<Window x:Class="Files.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="files settings" Width="760" Height="560" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <TextBlock x:Name="Message" DockPanel.Dock="Bottom" Margin="4,10,0,0" TextWrapping="Wrap" />
        <TabControl x:Name="Pages">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Shortcut to open files" Style="{StaticResource Heading}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="HotkeyBox" Width="240" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     PreviewKeyDown="OnHotkeyKey" AutomationProperties.Name="Shortcut" />
                            <TextBlock Text="Click, then press the keys. Delete turns it off." Margin="12,0,0,0"
                                       VerticalAlignment="Center" Style="{StaticResource Dim}" />
                        </StackPanel>
                        <TextBlock Text="Shortcut to search for the text under the mouse" Style="{StaticResource Heading}" />
                        <TextBox x:Name="OcrHotkeyBox" Width="240" HorizontalAlignment="Left" IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False" PreviewKeyDown="OnHotkeyKey"
                                 AutomationProperties.Name="Text under the mouse shortcut" />
                        <TextBlock Text="Behavior" Style="{StaticResource Heading}" />
                        <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Click="OnStartWithWindows" />
                        <CheckBox x:Name="HideOnBlurBox" Content="Hide when another window is clicked" Click="OnChanged" />
                        <CheckBox x:Name="HideAfterOpeningBox" Content="Hide after opening a file" Click="OnChanged" />
                        <TextBlock Text="History" Style="{StaticResource Heading}" />
                        <CheckBox x:Name="RememberBox" Content="Remember new searches and opened files" Click="OnChanged" />
                        <CheckBox x:Name="ShowOpenedBox" Content="Show recently opened files when the search box is empty" Click="OnChanged" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="ClearSearchesButton" Content="Clear recent searches" Click="OnClearSearches" />
                            <Button x:Name="ClearOpenedButton" Content="Clear recently opened" Margin="8,0,0,0" Click="OnClearOpened" />
                        </StackPanel>
                        <TextBlock Text="Favorites are kept when history is cleared." Margin="0,4,0,0" Style="{StaticResource Dim}" />
                        <TextBlock Text="Colors" Style="{StaticResource Heading}" />
                        <ComboBox x:Name="ThemeBox" Width="240" HorizontalAlignment="Left" SelectionChanged="OnChanged">
                            <ComboBoxItem Content="Follow Windows" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Volumes">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="Add a folder" Style="{StaticResource Heading}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Name" Margin="2,0,0,4" Style="{StaticResource Dim}" />
                            <TextBlock Grid.Column="1" Text="Folder, drive or \\server\share" Margin="10,0,0,4" Style="{StaticResource Dim}" />
                            <TextBox x:Name="NewVolumeName" Grid.Row="1" AutomationProperties.Name="Name" />
                            <TextBox x:Name="NewVolumePath" Grid.Row="1" Grid.Column="1" Margin="8,0" AutomationProperties.Name="Folder" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Click="OnBrowse" />
                            <Button Grid.Row="1" Grid.Column="3" Content="Add" Margin="8,0,0,0" Click="OnAddVolume" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="Read every volume again" VerticalAlignment="Center" />
                            <ComboBox x:Name="RescanBox" Width="150" Margin="10,0" SelectionChanged="OnChanged">
                                <ComboBoxItem Content="every hour" Tag="1" />
                                <ComboBoxItem Content="every 4 hours" Tag="4" />
                                <ComboBoxItem Content="every day" Tag="24" />
                                <ComboBoxItem Content="only on F5" Tag="0" />
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="HideSystemBox" Content="Skip hidden and system files (applies at the next read)" Click="OnChanged" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                        <Button Content="Read again" Click="OnRescanVolume" Margin="0,0,0,8" />
                        <Button Content="Remove" Click="OnRemoveVolume" />
                    </StackPanel>
                    <DataGrid x:Name="VolumeGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding Root}" Width="*" />
                            <DataGridTextColumn Header="Files" Binding="{Binding Files}" />
                            <DataGridTextColumn Header="Read" Binding="{Binding LastRead}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Search">
                <StackPanel Margin="12">
                    <TextBlock Text="File types never shown" Style="{StaticResource Heading}" />
                    <TextBox x:Name="HiddenBox" LostFocus="OnChanged" ToolTip="Extensions separated by commas" />
                    <TextBlock Text="Results" Style="{StaticResource Heading}" />
                    <CheckBox x:Name="ShowFoldersBox" Content="Show each result's folder on its own line" Click="OnChanged" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Opening">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Enter opens with" Style="{StaticResource Heading}" />
                        <ComboBox x:Name="EnterBox" Width="300" HorizontalAlignment="Left" SelectionChanged="OnChanged" />
                        <TextBlock Text="Programs to open files with" Style="{StaticResource Heading}" />
                    </StackPanel>
                    <DataGrid x:Name="ViewerGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                              HeadersVisibility="Column" RowEditEnding="OnGridEdited" CellEditEnding="OnGridEdited">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120" />
                            <DataGridTextColumn Header="Program" Binding="{Binding Program}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="About">
                <StackPanel Margin="12">
                    <TextBlock x:Name="VersionText" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="Updates" Style="{StaticResource Heading}" />
                    <CheckBox x:Name="CheckUpdatesBox" Content="Check for updates every few hours" Click="OnChanged" />
                    <TextBlock Text="Update folder (empty for GitHub releases)" Margin="0,8,0,4" />
                    <TextBox x:Name="UpdateFolderBox" LostFocus="OnChanged" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Check now" Click="OnCheckUpdate" />
                        <Button x:Name="InstallButton" Content="Install and restart" Margin="8,0,0,0" Click="OnInstallUpdate" />
                    </StackPanel>
                    <TextBlock Text="Data" Style="{StaticResource Heading}" />
                    <TextBlock x:Name="PathsText" TextWrapping="Wrap" Style="{StaticResource Dim}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
