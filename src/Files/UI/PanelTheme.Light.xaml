<!-- The panel's colors in light mode: the dark design's counterparts. PanelTheme.Dark.xaml holds the same keys. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PanelBackground" Color="#FAF9F7" />
    <SolidColorBrush x:Key="PanelFooter" Color="#F2F1ED" />
    <SolidColorBrush x:Key="Divider" Color="#E4E2DC" />
    <SolidColorBrush x:Key="Text" Color="#1F1E1D" />
    <SolidColorBrush x:Key="TextDim" Color="#5F5E5B" />
    <SolidColorBrush x:Key="TextFaint" Color="#85837F" />
    <SolidColorBrush x:Key="Accent" Color="#2F6FD6" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionFill" Color="#E2EBFA" />
    <SolidColorBrush x:Key="SelectionStroke" Color="#552F6FD6" />
    <SolidColorBrush x:Key="HoverFill" Color="#0A000000" />
    <SolidColorBrush x:Key="ControlFill" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlStroke" Color="#D6D4CD" />
    <SolidColorBrush x:Key="KbdStroke" Color="#CFCDC6" />
    <SolidColorBrush x:Key="Danger" Color="#C2412D" />
    <SolidColorBrush x:Key="Ok" Color="#2E9E6A" />
    <SolidColorBrush x:Key="Warn" Color="#B7791F" />
</ResourceDictionary>
