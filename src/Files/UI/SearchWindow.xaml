<Window x:Class="Files.UI.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Files.UI"
        Title="files"
        Width="680" Height="460"
        MinWidth="420" MinHeight="240"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource Text}">
    <!-- The empty space around the header drags the panel like a title bar (see UI/Snap.cs). -->
    <Border x:Name="DragArea" Background="Transparent">
        <DockPanel>
            <!-- The action menu (Tab or right-click on a result), opened beside the row (SearchWindow.Actions.cs). -->
            <Popup x:Name="ActionMenu" DockPanel.Dock="Top" PlacementTarget="{Binding ElementName=Results}" Placement="Relative"
                   StaysOpen="False" AllowsTransparency="True" Closed="OnActionMenuClosed">
                <Border Width="300" Margin="0,0,16,16" Padding="6" CornerRadius="10" BorderThickness="1"
                        Background="{DynamicResource ControlFill}" BorderBrush="{DynamicResource ControlStroke}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.35" />
                    </Border.Effect>
                    <DockPanel>
                        <TextBlock x:Name="ActionTitle" DockPanel.Dock="Top" FontSize="11" Margin="10,6,10,8"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextDim}" />
                        <Border DockPanel.Dock="Top" Height="1" Margin="0,0,0,4" Background="{DynamicResource Divider}" />
                        <ListBox x:Name="ActionList" MaxHeight="360" BorderThickness="0" Background="Transparent" Focusable="False"
                                 ItemContainerStyle="{StaticResource ActionItem}" ItemTemplate="{StaticResource ActionLine}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="OnActionClicked" />
                    </DockPanel>
                </Border>
            </Popup>
            <!-- The box is the panel's header: a search icon and no box chrome, then a divider. -->
            <Grid DockPanel.Dock="Top" Margin="12,10,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Input" FontSize="18" Padding="34,6,10,6" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                         AutomationProperties.Name="Search" TextChanged="OnInputChanged" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="10,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextFaint}" />
                <TextBlock x:Name="Placeholder" Text="Type to search" FontSize="18" Margin="37,7,0,0"
                           IsHitTestVisible="False" Foreground="{DynamicResource TextFaint}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Count" FontSize="12" Foreground="{DynamicResource TextDim}" Margin="12,0,0,0"
                               VerticalAlignment="Center" Visibility="Collapsed" />
                    <!-- Narrows the search to one volume; shown when there is more than one. Its own margin keeps it off the box when no count shows. -->
                    <Button x:Name="ScopeButton" Margin="12,0,0,0" Style="{StaticResource ControlButton}" Visibility="Collapsed"
                            AutomationProperties.Name="Volumes to search" Click="OnScopeClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ScopeLabel" Text="All volumes" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,1,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Divider}" />

            <!-- Filter chips, shown while searching (Ctrl+1 to Ctrl+5). -->
            <WrapPanel x:Name="Chips" DockPanel.Dock="Top" Margin="20,10,20,0" Visibility="Collapsed">
                <RadioButton Content="All" Tag="{x:Static ui:SearchFilter.All}" IsChecked="True" Style="{StaticResource Chip}" Checked="OnChipChecked" />
                <RadioButton Content="Files" Tag="{x:Static ui:SearchFilter.Files}" Style="{StaticResource Chip}" Checked="OnChipChecked" />
                <RadioButton Content="Folders" Tag="{x:Static ui:SearchFilter.Folders}" Style="{StaticResource Chip}" Checked="OnChipChecked" />
                <RadioButton Content="Code" Tag="{x:Static ui:SearchFilter.Code}" Style="{StaticResource Chip}" Checked="OnChipChecked" />
                <RadioButton Content="Documents" Tag="{x:Static ui:SearchFilter.Documents}" Style="{StaticResource Chip}" Checked="OnChipChecked" />
            </WrapPanel>

            <!-- Footer bar: index health on the left, key hints and settings on the right. -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelFooter}" BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,1,0,0" Padding="16,6,8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="14" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Ok}" />
                        <!-- Turns while volumes are scanned (SearchWindow.SetSpinning). -->
                        <TextBlock x:Name="Spinner" Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="SpinnerTurn" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                    <TextBlock x:Name="Status" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextDim}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel x:Name="Hints" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" />
                    <Button x:Name="SettingsButton" Grid.Column="3" Content="&#xE713;" Margin="8,0,0,0" Style="{StaticResource IconButton}"
                            ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings" Click="OnSettingsClick" />
                </Grid>
            </Border>

            <!-- The preview pane (Ctrl+P): details and first lines of the selected file (SearchWindow.Preview.cs). -->
            <Border x:Name="PreviewPane" DockPanel.Dock="Right" Width="400" Visibility="Collapsed" Padding="18,16"
                    Background="{DynamicResource PanelFooter}" BorderBrush="{DynamicResource Divider}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PreviewIcon" FontFamily="{StaticResource IconFont}" FontSize="24"
                                   Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PreviewPath" Margin="0,2,0,0" Style="{StaticResource RowPath}" />
                        </StackPanel>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Size" Style="{StaticResource PreviewLabel}" />
                            <TextBlock x:Name="PreviewSize" Text="–" Style="{StaticResource PreviewValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Modified" Style="{StaticResource PreviewLabel}" />
                            <TextBlock x:Name="PreviewModified" Text="–" Style="{StaticResource PreviewValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Type" Style="{StaticResource PreviewLabel}" />
                            <TextBlock x:Name="PreviewKind" Text="–" Style="{StaticResource PreviewValue}" />
                        </StackPanel>
                    </Grid>
                    <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Open" Style="{StaticResource AccentButton}" Click="OnPreviewOpen" />
                        <Button Grid.Column="2" Content="Show in folder" Style="{StaticResource ControlButton}" Click="OnPreviewReveal" />
                        <Button Grid.Column="4" Style="{StaticResource ControlButton}" ToolTip="Copy path (Ctrl+C)"
                                AutomationProperties.Name="Copy path" Click="OnPreviewCopy">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                        </Button>
                    </Grid>
                    <!-- The body: numbered lines, an image, a folder's entries, or a note. -->
                    <Grid Margin="0,14,0,0">
                        <Rectangle x:Name="PreviewFrame" RadiusX="8" RadiusY="8" StrokeThickness="1"
                                   Stroke="{DynamicResource Divider}" Fill="{DynamicResource PanelBackground}" />
                        <ScrollViewer x:Name="PreviewText" Margin="1" Padding="0,10" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Hidden" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PreviewNumbers" Margin="12,0,12,0" TextAlignment="Right" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextFaint}" />
                                <TextBlock x:Name="PreviewLines" Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap" />
                            </Grid>
                        </ScrollViewer>
                        <Image x:Name="PreviewImage" Margin="10" Stretch="Uniform" Visibility="Collapsed" />
                        <TextBlock x:Name="PreviewNote" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{DynamicResource TextDim}" />
                    </Grid>
                </DockPanel>
            </Border>

            <ListBox x:Name="Results" Margin="12,6,12,6" BorderThickness="0" Background="Transparent"
                     SelectionChanged="OnResultSelectionChanged"
                     ItemContainerStyle="{StaticResource ResultItem}" ItemTemplate="{StaticResource TwoLineRow}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnResultDoubleClick" PreviewMouseRightButtonUp="OnResultRightClick"
                     PreviewMouseLeftButtonDown="OnResultMouseDown" PreviewMouseMove="OnResultMouseMove">
            </ListBox>
        </DockPanel>
    </Border>
</Window>
