<!--
    The search panel's styles. Colors are DynamicResource keys from
    PanelTheme.Dark.xaml / PanelTheme.Light.xaml, which SearchWindow swaps with the theme.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Files.UI">
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <ui:UpperCase x:Key="UpperCase" />

    <!-- A key shown as a small bordered cap, as in "↵ Open". -->
    <Style x:Key="Kbd" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource KbdStroke}" />
        <Setter Property="Background" Value="{DynamicResource ControlFill}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,0,5,1" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KbdText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>

    <!-- A flat icon button, such as the gear: not focusable, so typing stays in the box. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="6,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverFill}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A filter chip: a pill, filled with the accent when chosen. Not focusable, so typing stays in the box. -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="GroupName" Value="Filter" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Pill" CornerRadius="12" Padding="12,4,12,5" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStroke}" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource HoverFill}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small bordered button, such as the volume menu or the preview's Show in folder. -->
    <Style x:Key="ControlButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="6" Padding="10,5" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStroke}" Background="{DynamicResource ControlFill}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The main button of the preview pane: filled with the accent. -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="6" Padding="10,7" Background="{DynamicResource Accent}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PreviewLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>
    <Style x:Key="PreviewValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- A line of the action menu (board 3): a separator above when it starts a group, the shortcut on the right. -->
    <Style x:Key="ActionItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <StackPanel>
                        <Border x:Name="Separator" Height="1" Margin="6,4" Background="{DynamicResource Divider}" Visibility="Collapsed" />
                        <Border x:Name="Chrome" CornerRadius="6" Padding="10,7" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SeparatorBefore}" Value="True">
                            <Setter TargetName="Separator" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Danger}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverFill}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionFill}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="ActionLine">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Border x:Name="Cap" Grid.Column="1" Style="{StaticResource Kbd}" Margin="10,0,0,0">
                <TextBlock Text="{Binding Gesture}" Style="{StaticResource KbdText}" />
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Gesture}" Value="">
                <Setter TargetName="Cap" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A result row: rounded, a soft accent fill and outline when selected. -->
    <Style x:Key="ResultItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome" Margin="0,1" Padding="{TemplateBinding Padding}" CornerRadius="8"
                            BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverFill}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionFill}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SelectionStroke}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Section labels cannot be selected or clicked. -->
            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Padding" Value="8,12,8,4" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Missing}" Value="True">
                <Setter Property="Opacity" Value="0.5" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- What both row layouts share: section labels, and the match in the accent color except on the selection. -->
    <Style x:Key="RowName" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RowIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RowPath" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="RowBadge" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Two lines: the name, then the folder (board 2). -->
    <DataTemplate x:Key="TwoLineRow">
        <Grid ToolTip="{Binding ToolTipText}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Icon" Text="{Binding Icon}" Style="{StaticResource RowIcon}" />
            <StackPanel x:Name="Body" Grid.Column="1">
                <TextBlock x:Name="Name" Style="{StaticResource RowName}">
                    <Run x:Name="Before" Text="{Binding Before, Mode=OneWay}" /><Run x:Name="MatchRun" Text="{Binding Match, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding After, Mode=OneWay}" />
                </TextBlock>
                <TextBlock x:Name="DetailLine" Text="{Binding Detail}" Margin="0,2,0,0" Style="{StaticResource RowPath}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Badge}" Style="{StaticResource RowBadge}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                <Setter TargetName="Before" Property="Text" Value="{Binding Before, Converter={StaticResource UpperCase}, Mode=OneWay}" />
                <Setter TargetName="Name" Property="FontSize" Value="11" />
                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextFaint}" />
                <Setter TargetName="DetailLine" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Body" Property="Grid.Column" Value="0" />
                <Setter TargetName="Body" Property="Grid.ColumnSpan" Value="2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False">
                <Setter TargetName="MatchRun" Property="Foreground" Value="{DynamicResource Accent}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One line: the folder follows the name (board 4). -->
    <DataTemplate x:Key="OneLineRow">
        <Grid ToolTip="{Binding ToolTipText}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Icon" Text="{Binding Icon}" Style="{StaticResource RowIcon}" />
            <TextBlock x:Name="Name" Grid.Column="1" Style="{StaticResource RowName}">
                <Run x:Name="Before" Text="{Binding Before, Mode=OneWay}" /><Run x:Name="MatchRun" Text="{Binding Match, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding After, Mode=OneWay}" /><Run x:Name="InlinePath" Text="{Binding Detail, Mode=OneWay, StringFormat='{}   {0}'}"
                    FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextDim}" />
            </TextBlock>
            <TextBlock Grid.Column="2" Text="{Binding Badge}" Style="{StaticResource RowBadge}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                <Setter TargetName="Before" Property="Text" Value="{Binding Before, Converter={StaticResource UpperCase}, Mode=OneWay}" />
                <Setter TargetName="Name" Property="FontSize" Value="11" />
                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextFaint}" />
                <Setter TargetName="InlinePath" Property="Text" Value="" />
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Name" Property="Grid.Column" Value="0" />
                <Setter TargetName="Name" Property="Grid.ColumnSpan" Value="2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False">
                <Setter TargetName="MatchRun" Property="Foreground" Value="{DynamicResource Accent}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
