#!/bin/sh
# Runs the repository checks before anything leaves this machine.
# Enable once per clone:  git config core.hooksPath .githooks
#
# The test suite is skipped here to keep pushes quick; CI runs it. To include
# it locally, push with FILES_HOOK_TESTS=1.

if [ "${FILES_HOOK_TESTS:-0}" = "1" ]; then
    exec sh tools/check.sh
fi
exec sh tools/check.sh --fast
