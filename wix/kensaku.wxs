<?xml version="1.0" encoding="utf-8"?>
<!--
  The bundled kensaku (docs/KENSAKU.md): the daemon that indexes file contents,
  the CLI whose `serve` answers searches, the ONNX Runtime they load, and their
  licences, in Program Files\files\kensaku. Built by tools/build_kensaku.ps1;
  tools/make_msi.ps1 adds this fragment unless it is given -SkipKensaku.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Directory Id="KensakuFolder" Name="kensaku" />
    </DirectoryRef>

    <!-- One file per component, so WiX can give each a stable generated GUID. -->
    <ComponentGroup Id="Kensaku" Directory="KensakuFolder">
      <Component Id="KensakuDaemon" Bitness="always64">
        <File Id="kensakuDaemon" Source="$(var.KensakuDir)\kensaku-daemon.exe" KeyPath="yes" />
      </Component>
      <Component Id="KensakuCli" Bitness="always64">
        <File Id="kensakuCli" Source="$(var.KensakuDir)\kensaku-cli.exe" KeyPath="yes" />
      </Component>
      <Component Id="KensakuOnnxRuntime" Bitness="always64">
        <File Id="kensakuOnnxRuntime" Source="$(var.KensakuDir)\onnxruntime.dll" KeyPath="yes" />
      </Component>
      <Component Id="KensakuLicense" Bitness="always64">
        <File Id="kensakuLicense" Source="$(var.KensakuDir)\LICENSE-kensaku.txt" KeyPath="yes" />
      </Component>
      <Component Id="OnnxRuntimeLicense" Bitness="always64">
        <File Id="onnxRuntimeLicense" Source="$(var.KensakuDir)\LICENSE-onnxruntime.txt" KeyPath="yes" />
      </Component>
      <Component Id="OnnxRuntimeNotices" Bitness="always64">
        <File Id="onnxRuntimeNotices" Source="$(var.KensakuDir)\ThirdPartyNotices-onnxruntime.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
