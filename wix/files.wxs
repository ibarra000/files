<?xml version="1.0" encoding="utf-8"?>
<!--
  The installer, written by hand against the WiX 5 schema.
  Build it with `tools/make_msi.ps1`.

  Installs one self-contained executable into Program Files with the PaddleOCR
  models beside it, one Start-menu shortcut and, optionally, a sign-in startup
  entry. It does not modify `PATH`.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- `UpgradeCode` must never change: Windows uses it to recognise a new
       version as an upgrade of this product. -->
  <Package Name="files"
           Manufacturer="files"
           Version="$(var.Version)"
           Scope="perMachine"
           Compressed="yes"
           Language="1033"
           UpgradeCode="4008c9cd-48d4-41af-9df8-4900fd2fdda3">

    <!-- Upgrades in place; refuses to downgrade with a message. -->
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of files is already installed. Uninstall it before installing this version." />

    <MediaTemplate EmbedCab="yes" />

    <!-- The icon Apps &amp; Features shows beside the entry. -->
    <Icon Id="ProductICO" SourceFile="assets\files.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductICO" />

    <!-- 64-bit only. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="files">

        <Component Id="MainExe" Bitness="always64">
          <File Id="filesExe" Source="$(var.TargetDir)\files.exe" KeyPath="yes" />
        </Component>

        <!-- PaddleOCR's models (Services/PaddleTextReader.cs), read beside files.exe;
             they are data, so they stay out of the single-file executable. -->
        <Directory Id="ModelsFolder" Name="models">
          <Directory Id="ModelsV5Folder" Name="v5">
            <!-- One file per component, so WiX can give each a stable generated GUID. -->
            <Component Id="PaddleDet" Bitness="always64">
              <File Id="paddleDet" Source="$(var.TargetDir)\models\v5\ch_PP-OCRv5_mobile_det.onnx" KeyPath="yes" />
            </Component>
            <Component Id="PaddleCls" Bitness="always64">
              <File Id="paddleCls" Source="$(var.TargetDir)\models\v5\ch_PP-LCNet_x0_25_textline_ori_cls_mobile.onnx" KeyPath="yes" />
            </Component>
            <Component Id="PaddleRec" Bitness="always64">
              <File Id="paddleRec" Source="$(var.TargetDir)\models\v5\latin_PP-OCRv5_rec_mobile_infer.onnx" KeyPath="yes" />
            </Component>
            <Component Id="PaddleKeys" Bitness="always64">
              <File Id="paddleKeys" Source="$(var.TargetDir)\models\v5\ppocrv5_latin_dict.txt" KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>

      </Directory>
    </StandardDirectory>

    <!-- Start-menu shortcut, placed directly under Programs rather than in a
         folder of its own. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="c1e147a0-08ef-4cd1-a0ef-6b1eb096439f">
        <Shortcut Id="FilesShortcut"
                  Name="files"
                  Description="files - nfs &amp; smb indexer"
                  Target="[INSTALLFOLDER]files.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ProductICO" />
        <!-- A shortcut cannot be a key path, so this registry value serves as the
             component's key path. -->
        <RegistryValue Root="HKCU"
                       Key="Software\files"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Start with Windows. Written under `HKCU` so the setting is per user,
         matching the per-user mapped drives the program reads. -->
    <Component Id="RunAtLogin" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="files"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]files.exe&quot;"
                     KeyPath="yes" />
    </Component>

    <Feature Id="Main"
             Title="files"
             Description="The search panel and its settings."
             Level="1"
             AllowAbsent="no">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="PaddleDet" />
      <ComponentRef Id="PaddleCls" />
      <ComponentRef Id="PaddleRec" />
      <ComponentRef Id="PaddleKeys" />
      <ComponentRef Id="StartMenuShortcut" />

      <!-- Selected by default. The installer, the Settings window's General page
           and Task Manager's Startup tab all control the same `Run` value. -->
      <Feature Id="StartWithWindows"
               Title="Start with Windows"
               Description="Start files at sign-in so the hotkey works immediately."
               Level="1"
               AllowAbsent="yes">
        <ComponentRef Id="RunAtLogin" />
      </Feature>
    </Feature>

    <!-- Feature-tree UI, so the startup option is visible and can be changed. -->
    <ui:WixUI Id="WixUI_FeatureTree" />
  </Package>
</Wix>
